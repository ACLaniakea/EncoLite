// Enco Lite — original UI, GPL-3.0-or-later, 2026-10-22.
import { ScrollView } from "std-widgets.slint";

export global Theme {
    in-out property <bool> dark: false;
    out property <color> canvas: dark ? #181f1c : #f7f9f8;
    out property <color> sidebar: dark ? #141b18 : #edf1ef;
    out property <color> card: dark ? #202b25 : #ffffff;
    out property <color> text: dark ? #e2eee7 : #1c3027;
    out property <color> muted: dark ? #9cafa3 : #77877d;
    out property <color> line: dark ? #34443a : #e3eae6;
    out property <color> accent: dark ? #8bdbb6 : #17684b;
    out property <color> selected: dark ? #31483b : #dfede4;
}

export component Label inherits Text {
    color: Theme.text;
    font-size: 14px;
    vertical-alignment: center;
}

export component Card inherits Rectangle {
    background: Theme.card;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.line;
}

export component Action inherits Rectangle {
    in property <string> label;
    in property <length> text-size: 12px;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked();
    width: 104px;
    height: 34px;
    border-radius: 6px;
    background: root.primary ? (area.has-hover ? #245f48 : #17684b) : (area.has-hover ? Theme.selected : Theme.card);
    border-width: root.primary ? 0px : 1px;
    border-color: Theme.line;
    opacity: enabled ? 1 : 0.4;
    Label { text: root.label; horizontal-alignment: center; color: root.primary ? #fff : Theme.text; font-size: root.text-size; }
    area := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component NavItem inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> selected;
    callback clicked();
    width: 132px;
    height: 38px;
    border-radius: 7px;
    background: selected ? Theme.selected : area.has-hover ? Theme.line : transparent;
    if selected: Rectangle { x: 0px; y: 12px; width: 3px; height: 18px; border-radius: 2px; background: Theme.accent; }
    Image { source: root.icon; x: 17px; y: 12px; width: 18px; height: 18px; colorize: root.selected ? Theme.accent : Theme.muted; }
    Label { x: 43px; text: root.label; color: root.selected ? Theme.accent : Theme.text; font-size: 12px; font-weight: root.selected ? 600 : 400; }
    area := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component Toggle inherits Rectangle {
    in property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);
    width: 38px;
    height: 21px;
    border-radius: 11px;
    background: checked ? Theme.accent : Theme.line;
    opacity: enabled ? 1 : 0.4;
    Rectangle {
        x: root.checked ? 20px : 3px;
        y: 3px;
        width: 15px;
        height: 15px;
        border-radius: 8px;
        background: root.checked ? Theme.card : Theme.muted;
    }
    TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.toggled(!root.checked); } }
}

export component SettingRow inherits Card {
    in property <image> icon;
    in property <string> title;
    in property <string> description;
    in property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);
    height: 64px;
    Rectangle { x: 18px; y: 14px; width: 32px; height: 32px; border-radius: 8px; background: Theme.canvas;
        Image { source: root.icon; x: 7px; y: 7px; width: 18px; height: 18px; colorize: Theme.accent; }
    }
    Label { x: 61px; y: 10px; height: 22px; text: root.title; font-size: 12px; font-weight: 600; }
    Label { x: 61px; y: 35px; height: 18px; text: root.description; font-size: 10px; color: Theme.muted; }
    Toggle { x: parent.width - 62px; y: 22px; checked: root.checked; enabled: root.enabled; toggled(value) => { root.toggled(value); } }
}

export component BatteryTile inherits Card {
    in property <string> label;
    in property <string> value;
    in property <float> level;
    in property <image> picture;
    in property <bool> charging: false;
    height: 72px;
    Image { x: 10px; y: 10px; width: 31px; height: 51px; source: root.picture; image-fit: contain; colorize: Theme.accent; }
    Label { x: 52px; y: 9px; height: 18px; text: root.label; font-size: 10px; color: Theme.muted; }
    Image { x: parent.width - 22px; y: 10px; width: 10px; height: 15px; source: @image-url("assets/charging.svg"); colorize: Theme.accent; visible: root.charging; }
    Label { x: 52px; y: 28px; width: parent.width - 62px; height: 29px; text: root.value; font-size: 21px; font-weight: 600; }
    Rectangle { x: 52px; y: 59px; width: parent.width - 68px; height: 3px; border-radius: 2px; background: Theme.line;
        Rectangle { x: 0px; y: 0px; width: parent.width * root.level; height: 3px; border-radius: 2px; background: Theme.accent; }
    }
}

export component ModeTile inherits Rectangle {
    in property <string> label;
    in property <length> text-size: 12px;
    in property <string> detail;
    in property <image> icon;
    in property <bool> selected;
    in property <bool> enabled: true;
    callback clicked();
    height: 52px;
    border-radius: 8px;
    background: root.selected ? Theme.selected : area.has-hover ? Theme.canvas : Theme.card;
    border-width: 1px;
    border-color: root.selected ? Theme.accent : Theme.line;
    opacity: enabled ? 1 : 0.45;
    Image { x: parent.width / 2 - 30px; y: (parent.height - 18px) / 2; width: 18px; height: 18px; source: root.icon; colorize: root.selected ? Theme.accent : Theme.muted; }
    Label { x: parent.width / 2 - 3px; y: (parent.height - 24px) / 2; width: 34px; height: 24px; text: root.label; font-size: root.text-size; font-weight: root.selected ? 600 : 400; }
    area := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component Chip inherits Rectangle {
    in property <string> label;
    in property <length> text-size: 12px;
    in property <bool> selected;
    in property <bool> enabled: true;
    callback clicked();
    height: 30px;
    border-radius: 5px;
    background: root.selected ? Theme.selected : area.has-hover ? Theme.canvas : transparent;
    Label { text: root.label; horizontal-alignment: center; color: root.selected ? Theme.accent : Theme.muted; font-size: root.text-size; }
    area := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

