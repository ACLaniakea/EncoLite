export struct PresetItem { id: int, name: string, detail: string }
export struct SwitchItem { key: string, title: string, detail: string, checked: bool, enabled: bool }
export struct NoiseItem { key: string, name: string }
export struct BandItem { label: string, gain: int }
export struct DeviceItem { address: string, name: string, detail: string, connected: bool }
export component TypeDefinitions inherits Window { width: 1px; height: 1px; }
